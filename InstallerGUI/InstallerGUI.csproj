<Project ToolsVersion="4.0"
  xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>WinExe</OutputType>
    <RootNamespace>InstallerGUI</RootNamespace>
    <AssemblyName>Instalador Automatico Exabit</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>install.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <HighEntropyVA>true</HighEntropyVA>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <OutputPath>bin\Release\</OutputPath>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Forms\MainForm.cs" />
    <Compile Include="Models\ProgramInfo.cs" />
    <Compile Include="Services\InstallerService.cs" />
    <Compile Include="Services\InstallerService.Downloads.cs" />
    <Compile Include="Services\InstallerService.ProcessRunner.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <EmbeddedResource Include="Image\logo_exabit.png">
      <LogicalName>InstallerGUI.logo_exabit.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Sound\R2D2.mp3">
      <LogicalName>InstallerGUI.R2D2.mp3</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Scripts\apply_wallpapers.ps1">
      <LogicalName>InstallerGUI.apply_wallpapers.ps1</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="app.manifest" />
    <None Include="build.bat" />
    <None Include="install.ico" />
    <None Include="sign.ps1" />
    <None Include="validate-version.ps1" />
  </ItemGroup>
  <Target Name="ValidateApplicationVersion" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\validate-version.ps1&quot;" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
